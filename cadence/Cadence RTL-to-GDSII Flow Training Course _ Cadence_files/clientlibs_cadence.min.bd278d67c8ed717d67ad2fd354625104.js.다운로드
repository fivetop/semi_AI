        var el = element[0];
        var divHeight = el.offsetHeight
        var lineHeight = parseInt(window.getComputedStyle(el, null).getPropertyValue('line-height'));
        var lines = divHeight / lineHeight;
        return Math.round(lines);
      }
      function checkexpansion(accordion){
        accordion_controls = $('.acco-expand', accordion);
        accordion_buttons =  $('.accordion-trigger', accordion);
        accordion_expand_status = 0    /// start with 0 if any button is expanded then increase by one, to check if all are open or not
        accordion_buttons.each(function(){
          if ($(this).attr('aria-expanded') == 'true') {
            accordion_expand_status++;   
          }
        });
        if (accordion_expand_status == accordion_buttons.length) {
          $('.all', accordion_controls).addClass('hidden');
          $('.none', accordion_controls).removeClass('hidden')
        } else {
          $('.none', accordion_controls).addClass('hidden');
          $('.all', accordion_controls).removeClass('hidden');
        }
      }
