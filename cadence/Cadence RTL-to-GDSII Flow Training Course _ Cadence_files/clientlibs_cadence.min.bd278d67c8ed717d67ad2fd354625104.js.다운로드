    function tabbingRightside(action, elem){
        parent = elem.closest('div.tab-container');
            if (action == 'disable') {
                $('.rightside > *', parent).css('display', "none");
            }
            if (action == 'enable') {
                $('.rightside > *', parent).css('display', "");
            }
    }

    function highlightInandOutRightside(action, elem){
        parent = elem.closest('div.tab-container');
            if (action == 'disable') {
