    } else {
      keycode = event.keyCode || event.which;  
    }

    if (keycode != ctxKeyboard.ENTER && keycode != ctxKeyboard.TAB && event.type != "mouseover" && event.type != "click" ) {
      return true;
    }  
    if(keycode == ctxKeyboard.TAB) {
      $(this).next().focus();
      return true;
    }
    if (!$(this).hasClass(showClass) ) {
      disableActiveDropdowns();
      $(this).addClass(showClass);
