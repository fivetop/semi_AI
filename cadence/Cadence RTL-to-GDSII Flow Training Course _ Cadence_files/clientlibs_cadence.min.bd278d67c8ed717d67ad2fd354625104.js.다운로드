Cadence_ClickStreamFunctions.trackingpageDetail = function(){
    pageDetail = {};
    if (typeof(originalData) !== 'undefined') {
        if (typeof(originalData.page.pageInfo)!== 'undefined') {
            pageDetail.pagename = originalData.page.pageInfo.pageName;    
        } else {
            pageDetail.pagename = digitalData.page.pageDetails.pageName;
        }
        if ( pageDetail.pagename == '') {
            pageDetail.pagename = 'HomePage';
        }
    } else {
        pageUrl = window.location.href.split(/[?#]/)[0];
        if (window.location.href.indexOf("home.html") > -1) {
            pageDetail.pagename = 'HomePage';
        } else {
            tempPage = window.location.pathname.split('home/')[1]
            pageDetail.pagename = ':'+tempPage.replaceAll('/',':')
        }

    }
    pageDetail.url = window.location.href.split(/[?#]/)[0];
    pageDetail.title = document.title;
    pageDetail.oldurl = "";
    pageDetail.oldtitle = "";
    pageDetail.lang = $('body').data('language');
    if (decodeURIComponent(escape(atob(window.trackURLfromcookie))) != "" ) {
        pageDetail.oldurl = decodeURIComponent(escape(atob(window.trackURLfromcookie)));    
    }
    //get from cookie
    if (decodeURIComponent(escape(atob(window.trackTitlefromcookie))) != "") {
        pageDetail.oldtitle = decodeURIComponent(escape(atob(window.trackTitlefromcookie)));    
    }
    return pageDetail    
};

