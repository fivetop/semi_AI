Cadence_ClickStreamFunctions.trackingpathvalidation = function(url){
    if (url.indexOf('#') == 0) {
        absUrl = window.location.href + url;
        return absUrl 
    }
    if (url.indexOf('://') == -1) {
        domain = window.location.origin;
        absUrl = domain + url;
        return absUrl 
    } else {
        return url
    }
};

