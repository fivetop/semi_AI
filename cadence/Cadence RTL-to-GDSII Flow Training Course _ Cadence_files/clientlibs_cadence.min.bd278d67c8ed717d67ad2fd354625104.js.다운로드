"use strict";
// slider collapse for tabs

function showHideNextArrow(slider, index) {
	var containerWidth = slider.width(),
		lastSlide = slider.find('li').last(),
		lastSlideWidth = lastSlide.width(),
		lastSlideLeft = lastSlide.offset().left;

	if (containerWidth > (lastSlideWidth + lastSlideLeft)) {
		slider.find('.slick-next').addClass('slick-disabled');
	} else {
		slider.find('.slick-next').removeClass('slick-disabled');
	}
	
	slider.find('ul.nav-tabs').slick('slickGoTo', index);
}

function slickCheckInit() {
	var sliders = $('[data-component="tabs-list-slider"]');
	
	sliders.on('click', '[data-toggle="tab"]', function () {
		if ( $(this).parent().data('slick-index') !== undefined) {
			sliders.find('ul.nav-tabs').slick('slickGoTo', $(this).parent().data('slick-index'));
		}
	});
	
	
	sliders.each(function () {
		var el = $(this),
			initialWidth = 0,
	    	maxWidth = el.data('max-width') ? el.data('max-width') : 998,
	    	index = 0;
	
	    el.find('ul.nav-tabs li').each(function(){
	        initialWidth += $(this).outerWidth();
	        if ($(this).hasClass('active')) {
	        	index = $(this).index();
	        }
	    });
	    
		if (((el.width() - 15) < initialWidth) && (window.innerWidth < maxWidth)) {
			if (!el.find('ul.nav-tabs').hasClass('slick-initialized')) {
				var carousel = el.find('ul.nav-tabs').slick({
				  dots: false,
				  infinite: false,
				  autoplay: false,
				  slidesToShow: 1,
				  centerMode: false,
				  variableWidth: true,
				  prevArrow: '<button type="button" class="slick-prev"><svg viewBox="6 0 24 24" width="17" height="17" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><polyline points="15 18 9 12 15 6"></polyline></svg></button>',
				  nextArrow: '<button type="button" class="slick-next"><svg viewBox="6 0 24 24" width="17" height="17" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><polyline points="9 18 15 12 9 6"></polyline></svg></button>'
				});
				
				carousel.on('afterChange', function() {
					showHideNextArrow(el);
				});
				carousel.on('init', function() {
					showHideNextArrow(el, index);
				});
			}
			showHideNextArrow(el, index);
		} else {
			if (el.find('ul.nav-tabs').hasClass('slick-initialized')) {
				el.find('ul.nav-tabs').slick('unslick');
			}
		}
	
	});
}

$(document).ready(function () {
	if ($('[data-component="tabs-list-slider"]').length) {
		var el = $('[data-component="tabs-list-slider"]');
		
		el.find('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
