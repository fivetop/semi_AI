//get position to place the drodown
function getActiveDropdownPosition(...args) {
  /* 
  Arg[0] = $(this).parent()
  Arg[1] = $secondLevlDrop
  Arg[2] = $dropdoWidth
  */
  pos = {};
  parentCut = false;
  var elmOffset = args[0].offset().left;
  var slickWrapper = args[0].parent().closest('.slick-list');
  if (slickWrapper.length <= 0) {
    slickWrapper = args[0].parent().closest('.context_menu_module');
  }
  var slickrightOffset = slickWrapper.offset().left + slickWrapper.outerWidth();
  var isEntirelyVisible = ( (elmOffset + args[2]) <= slickrightOffset);
  var postop = (args[0].closest('.context_menu_module').offset().top + args[0].closest('.context_menu_module').innerHeight());
  if ( args[0].offset().left + args[0].outerWidth() >= slickrightOffset) {
    var posleft =  slickrightOffset;
    var parentCut = true;
  } else {
    var posleft =  args[0].offset().left;  
  }
  var dropchildpos = 'left';
  if ( !isEntirelyVisible) {
    posleft = args[0].offset().left + args[0].outerWidth() - args[2];
  }
  //recalculate if the parent is not completely visible
  if (parentCut) {
    posleft =  slickrightOffset - args[2];  
  }
  // check if the 2nd level fits on the screen
  if ($('.snd-level', args[1]).length >= 1) {
    var isChildVisible = ( (posleft + (args[2]) * 2) <= slickrightOffset);  
    if ( !isChildVisible) {
      $('.dropdown-menu', args[1]).css("right", (args[2] - 2)).addClass('right');
    }
    var dropchildpos = 'right';
  }
  
  pos.top = postop;
  pos.left = posleft;
  pos.childposition = dropchildpos;
  return (pos);
}
