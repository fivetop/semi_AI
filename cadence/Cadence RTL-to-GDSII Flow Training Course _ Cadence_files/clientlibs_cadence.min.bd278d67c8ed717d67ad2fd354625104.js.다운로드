function carouselnormal(){
    $('#videos').each(function(){
            if ($('#cdn-nxtgn-videosCarousel', this).hasClass('dual') ){
                videosshow = 2;
                videoCol = 6;
            } else {
                videosshow = 3;
                videoCol = 4;
            }
            var allvideos = $('#cdn-nxtgn-videosCarousel .carousel-inner .item .col-lg-'+videoCol+'', this);
            allvideos.each(function(){
                if ( $(this).parent().hasClass('item') ) $(this).unwrap();  
            });
            var allvideosUnwrap = $('#cdn-nxtgn-videosCarousel .carousel-inner .col-lg-'+videoCol+'', this);
            for(var i = 0; i < allvideosUnwrap.length; i+=videosshow) {
                allvideosUnwrap.slice(i, i+videosshow).wrapAll("<div class='item'></div>");
            }    
            $('#cdn-nxtgn-videosCarousel .carousel-inner .item:nth-of-type(1)', this).addClass('active');
            $('#cdn-nxtgn-videosCarousel', this).carousel({interval: 10000});
    });
}

function validatevideos() {
    if ( $( window ).width() >= 767 ) {    
        $('#videos').each(function(){
                if ( $('#cdn-nxtgn-videosCarousel', this).hasClass('dual') ){
                    normalcarousel = 2;
                    videosshow = 2;
                    videoCol = 6;
                } else {
                    normalcarousel = 3;
                    videosshow = 3;
                    videoCol = 4;
                }
                var lastitem = $('#cdn-nxtgn-videosCarousel .carousel-inner .item:last-child > div', this).length;
                if ( lastitem < videosshow ) {
                    var allvideos = $('#cdn-nxtgn-videosCarousel .carousel-inner .item .col-lg-'+videoCol+'', this);
                    var originallength = $('#cdn-nxtgn-videosCarousel .carousel-inner .item .col-lg-'+videoCol+':not(".duplicate")', this).length;
                    $("<div class='tempwrapper'></div>").appendTo($('#cdn-nxtgn-videosCarousel .carousel-inner', this));
                    $tempwrap = $('#cdn-nxtgn-videosCarousel .carousel-inner div.tempwrapper');
                    $lastdiv = $('#cdn-nxtgn-videosCarousel .carousel-inner .item:nth-last-of-type(2)', this);
                    for (var indexoriginal = 0;  ( (indexoriginal +1) + lastitem ) <= videosshow; indexoriginal++) {
                        allvideos.eq(indexoriginal).clone(true).addClass('duplicate').appendTo($lastdiv);
                    }
                    finalVideo = false;
                    while (!finalVideo == true) {
                        for(var i = 0; i < normalcarousel; i++){
                            if ( (indexoriginal+1) > originallength ) {
                               indexoriginal = 0;
                            }
                            allvideos.eq(indexoriginal).clone(true).addClass('duplicate').appendTo($tempwrap);
                            indexoriginal++;      
                        }
                        if ( $('div:last-child a', $tempwrap).attr( "title" ) == $('a', allvideos.eq(originallength-1)).attr( "title" )) {
                            finalVideo = true;
                        }
                    }//while
                    allvideosUnwrapDup = $('#cdn-nxtgn-videosCarousel .carousel-inner .tempwrapper .col-lg-'+videoCol+'', this);
                    allvideosUnwrapDup.each(function(){
                        if ( $(this).parent().hasClass('tempwrapper') ) $(this).unwrap();  
                    });
                    for(var i = 0; i < allvideosUnwrapDup.length; i+=videosshow) {
                        allvideosUnwrapDup.slice(i, i+videosshow).wrapAll("<div class='item'></div>");
                    }
                } // incomplete videos
                //dup = new CADENCE.Modal($('.duplicate a.video_view', this), null) // add modal attribute
        });
    } // window width
}
