                var extraheight = 30;
              }else {
                var extraheight = 13;
              }
              $('.content', $(this)).css('transform', 'translateY(-'+(getheight+extraheight)+'px)'),
              $('.content p.subcontent', $(this)).css('height', getheight);
            }
        }
      },
      function(event) {
        $('.content p.subcontent', $(this)).css('height', 0);
        $('.content', $(this)).css('transform', 'translateY(0)');
      }
    );
    $('.fadeupcontent .content').one('transitionend webkitTransitionEnd oTransitionEnd', function () {
      $(this).parent().toggleClass('active');
    });
    $(window).resize(function() {
      updateInfoboxposition();
    });
  }
});


