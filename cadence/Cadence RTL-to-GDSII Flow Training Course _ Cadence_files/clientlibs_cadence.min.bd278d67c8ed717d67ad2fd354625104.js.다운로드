Cadence_ClickStreamFunctions.searchStreamTrackCookies = function(){
    window.trackURLfromcookie = "";
    window.trackTitlefromcookie = "";
    if ( typeof ($.cookie('_tr_pre_u')) == 'undefined') {
        //create cookie
        $.cookie('_tr_pre_u', btoa(unescape(encodeURIComponent(window.location.href.split(/[?#]/)[0]))), { path: '/' });
        $.cookie('_tr_pre_prev_u', "", { path: '/' });   
    } else {
        window.trackURLtemp =  decodeURIComponent(escape(atob($.cookie('_tr_pre_u'))));
        if ( window.trackURLtemp != window.location.href.split(/[?#]/)[0]) {
            $.removeCookie('_tr_pre_prev_u', { path: '/' });
            $.cookie('_tr_pre_prev_u', $.cookie('_tr_pre_u'), { path: '/' });
            $.removeCookie('_tr_pre_u', { path: '/' });
            $.cookie('_tr_pre_u', btoa(unescape(encodeURIComponent(window.location.href.split(/[?#]/)[0]))), { path: '/' });
        }
        window.trackURLfromcookie = $.cookie('_tr_pre_prev_u');
    }
    if ( typeof ($.cookie('_tr_pre_t')) == 'undefined') {
        //create cookie
        $.cookie('_tr_pre_t', btoa(unescape(encodeURIComponent(document.title))), { path: '/' });
        $.cookie('_tr_pre_prev_t', "", { path: '/' });    
    }else {
        window.trackTitletemp = decodeURIComponent(escape(atob($.cookie('_tr_pre_t'))));
        if ( window.trackTitletemp != document.title) {
            $.removeCookie('_tr_pre_prev_t', { path: '/' });
            $.cookie('_tr_pre_prev_t', $.cookie('_tr_pre_t'), { path: '/' });
            $.removeCookie('_tr_pre_t', { path: '/' });
            $.cookie('_tr_pre_t', btoa(unescape(encodeURIComponent(document.title))), { path: '/' }); 
            window.trackTitlefromcookie = $.cookie('_tr_pre_prev_t');
        }
        window.trackTitlefromcookie = $.cookie('_tr_pre_prev_t'); 
    }
};

