          if ( $('.code-block-popover').hasClass('top') ) {
            $('.code-block-popover').css('top', $('.code-block-popover').offset().top - 20);
          }
        });
        function CodeblockStartInterval(){
            Codeinterval = setInterval(function(){
                if ( $('.code-text-copy[aria-describedby]').length) {
                    current = new Date().getTime();
                    $('.code-text-copy[aria-describedby]').each(function(){
                        og_event = $(this).attr('data-activated-time');
                        diff = current - og_event;
                        seconds = Math.floor(diff / 1000 % 60);
                        if (seconds >= 2) {
                            popid = $(this).attr('aria-describedby');
                            $(this).popover('hide');
                        }
                    })
                } else {
                    CodeblockPauseInterval();    
                }
            },2000)
        }
        function CodeblockPauseInterval() {
            clearTimeout(Codeinterval);
            CodeblockInterval=false; 
        }

        $('.code-text-copy').on('hide.bs.popover', function () {
            if ( $(this).attr('data-activated-time') ) {
                popid = $(this).attr('aria-describedby');
