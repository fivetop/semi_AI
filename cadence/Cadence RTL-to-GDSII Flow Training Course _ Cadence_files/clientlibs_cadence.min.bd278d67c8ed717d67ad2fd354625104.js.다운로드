                //$('body').addClass('popover-copy')
                tempopid = $(this).attr('aria-describedby');
                $(this).popover('show');
                $('#'+tempopid+'').remove();
                timestamp = new Date().getTime();
                $(this).attr('data-activated-time', timestamp);
                popid = $(this).attr('aria-describedby');
                $('#'+popid+'').addClass('popover-copy');
                if(CodeblockInterval==false){
                    CodeblockInterval = true;
                    CodeblockStartInterval();
