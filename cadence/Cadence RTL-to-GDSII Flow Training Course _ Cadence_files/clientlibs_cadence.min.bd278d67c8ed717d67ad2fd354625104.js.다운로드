$(function() {
    // on page load open tab is hash is present
    if ( $('.contentTabs.section').length ) {
        const contentTablistSliderOptions = {
            prevarrow: `<button class="arrows left"  aria-label="previous link">
                        <svg viewBox="6 0 24 24" width="17" height="17" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1">
                        <polyline points="15 18 9 12 15 6"></polyline>
                        </svg></button>`,
            nextarrow: `<button class="arrows right" aria-label="next link">
                        <svg viewBox="6 0 24 24" width="17" height="17" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1">
                        <polyline points="9 18 15 12 9 6"></polyline>
                        </svg></button>`,
            activeClass: `visible`,
            arrowsonmobile: false

        }
        function prepareContentTabsSlider(){
            $('.contentTabs').each(function(){
                if (window.innerWidth <= 767 && $('.ul-container', $(this)).attr('data-desktop-view') == "vertical") {
                    listSliderizer($(this))    
                }
                if ($('.ul-container', $(this)).attr('data-desktop-view') == "horizontal") {
                    listSliderizer($(this))    
                }
            });
        }
        prepareContentTabsSlider();

        function listSliderizer(element){
            $('.ul-container', element).wrap('<div class="flex slider-nav-wrapper"><div class="slider-component"><div class="slider-container"></div></div></div>');
            $('.nav-tabs', element).listSlider(contentTablistSliderOptions);
            $('.list-slider-module', element).css('width', element.innerWidth());
            $('.nav-tabs', element).listSlider('checkvisibles');    
        }

        function unlistSliderizer(element){
            $('.list-slider-module', element).removeAttr('style');
            $('.ul-container', element).unwrap().unwrap().unwrap();
        }


        $(window).resize(function () {
            $('.contentTabs').each(function(){
                if (window.innerWidth >= 768 && $('.ul-container', $(this)).attr('data-desktop-view') == "vertical") {
                    if (listSlider.prototype.isInitialized($('.nav-tabs', $(this)))) {
                        $('.nav-tabs', $(this)).listSlider('destroy');
                        unlistSliderizer($(this));
                    }
                }
                if (window.innerWidth <= 767 && $('.ul-container', $(this)).attr('data-desktop-view') == "vertical") {
                    if (!listSlider.prototype.isInitialized($('.nav-tabs', $(this)))) {
                        listSliderizer($(this)) 
                    }
                }

            })
        });

        var url = document.location.toString();
        if (url.match('#')) {
            $('.contentTabs a[href="#' + url.split('#')[1] + '"]').tab('show');
            $selectedContent = $('#' +url.split('#')[1]).closest('.contentTabs');
            if (listSlider.prototype.isInitialized($('.nav-tabs', $selectedContent))) {
                $selectedli = $('.contentTabs a[href="#' + url.split('#')[1] + '"]').parent().index();
                $('.nav-tabs', $selectedContent).listSlider('listGoto', $selectedli);
            }
            if ($('.contentTabs a[href="#' + url.split('#')[1] + '"]').length >= 1 ) {
                defaultspace = 45;
                contextnav = 0;
                sectionnav = 0;
                contentTabOffset = 0;
                if ($('.context_menu_module.section').length ){
                    contextnav = $('.context_menu_module.section').height()
                }
                if ($('.sectionnav.section').length ){
                    sectionnav = $('.sectionnav.section').height()
                }
                topspacer = defaultspace + contextnav + sectionnav;
                if ($('#' +url.split('#')[1]).closest('.contentTabs').length >= 1) {
                    var contentTabOffset = ($('#' +url.split('#')[1]).closest('.contentTabs').offset().top - topspacer);
                    window.scrollTo(0, 0);
                    window.scrollTo(0,contentTabOffset);
                }   
            }
            
        } 
        
        // Change hash for page-reload
        $('.nav-tabs a').on('shown.bs.tab', function (e) {
            if(history.pushState) {
                history.pushState(null, null, e.target.hash);
            }
            else {
                location.hash = e.target.hash;
            }
        });
    }
});

