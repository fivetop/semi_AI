$(function() {
	if ( $('.verticaltabs.section').length ) {
		var verticaltabsComponent = $('.verticaltabs.section');
		verticaltabsComponent.each(function(){
			verticalTab = $(this);
			$('.nav-tabs li:last a', verticalTab).addClass('lastchild');
			var tabsVertical = $('.vertical-tab-container > .nav-tabs li', verticalTab);
			tabsVertical.each(function(){
				currentactive = false
				tabVertical = $(this);
				tabpanel = $('a', tabVertical);
				tabattr = tabpanel.attr('data-panel');
				if (tabpanel.hasClass('lastchild') ) {
					$('#'+tabattr+'.tab-pane', verticalTab).addClass('lastbox');
				}
				panel = $('#'+tabattr+'.tab-pane', verticalTab);
				if (panel.hasClass('active') ) {
					currentactive = true;
				} else {
					panel.addClass('active');
				}
				if ( panel.find(':focusable').length ) {
					tabpanel.addClass('panelwithanchor');
					panel.find(':focusable').first().addClass('backtab_backtotabs');
					panel.find(':focusable').last().addClass('tab_backtotabs');
					if ( panel.hasClass('lastbox') ) {
						panel.find(':focusable').last().removeClass('tab_backtotabs');
					}
				}
				if ( !currentactive ) {
					panel.removeClass('active');
				}
			})
		});

		var accordionLessMore = $('.view-more-less', verticaltabsComponent);
		accordionLessMore.each(function(){
			var targetLessBtn = $(this).attr('data-target');
			$(targetLessBtn).attr('aria-hidden', true);
			$(this).on('click', function(){
				if ( $(targetLessBtn).attr('aria-hidden') == "true" ) {
					$(targetLessBtn).attr('aria-hidden', false)
				} else {
					$(targetLessBtn).attr('aria-hidden', true)
				}
			});
		});


		$('body').on("keydown", '.panelwithanchor', function(e){
	    	if(event.shiftKey && event.keyCode == 9) {
	        	keycode =  38;
	      	} else {
	        	keycode = event.keyCode || event.which;
	      	}
	      	if ( $(this).parent().hasClass('active') ) {
	      		switch (keycode) {
		        	case Keyboard.TAB:
		        		tabattr = $(this).attr('data-panel');
		        		panel = $('#'+tabattr+'.tab-pane', verticalTab);
		        		panel.find(':focusable').first().focus();
		          		return false
		        	break;
		      	}	
	      	}
	    });

		$('body').on("keydown", '.backtab_backtotabs', function(e){
	      if(event.shiftKey && event.keyCode == 9) {
	        keycode =  38;
	      } else {
	        keycode = event.keyCode || event.which;
	      }
	      switch (keycode) {
	        case Keyboard.UP:              
	          var currentModule = $(this).closest('.verticaltabs');
	          $('.nav-tabs li.active a', currentModule).focus();
	          return false;
	        break;
	      }
	    });
	    $('body').on("keydown", '.tab_backtotabs', function(e){
	    	if(event.shiftKey && event.keyCode == 9) {
	        	keycode =  38;
	      	} else {
	        	keycode = event.keyCode || event.which;
	      	}
	      	switch (keycode) {
	        	case Keyboard.TAB:
	        		var currentModule = $(this).closest('.verticaltabs');
	          		if ( $('.nav-tabs li.active', currentModule).next().is('li') ){
	          			var activeTab = $('.nav-tabs li.active', currentModule);
	          			$(activeTab).next().find('a').focus();
	          			return false
	          		}
	        	break;
	      	}
	    });
	};
});
