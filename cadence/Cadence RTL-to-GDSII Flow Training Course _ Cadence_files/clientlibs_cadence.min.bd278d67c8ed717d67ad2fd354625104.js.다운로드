          $(this).next().stop().slideDown(300);
          if ( thisTitle.hasClass('accordion-title') && (typeof thisTitle.attr('data-ogtitle') !== "undefined") ){
            thisTitle.text(thisTitle.attr('data-ogtitle'));  
          }  
