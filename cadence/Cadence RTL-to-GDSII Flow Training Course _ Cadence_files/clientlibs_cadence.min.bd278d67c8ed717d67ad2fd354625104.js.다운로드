$(function() {
  if ($('.list-container').length >= 1) {
    $('.list-container .content .filteredContent a').on('click', function(){
      $(this).css('pointer-events', 'none');
      var module_action = $(this).closest('.content');
      list_container_showmore('','',module_action);
    });

    function list_container_showmore(param, restore, activemodule){
      if (activemodule.attr('data-url') === undefined) {
        activemodule = activemodule.closest('.content');
      }
      var temptext = $('.filteredContent a', activemodule).text();
      $('.filteredContent a', activemodule).attr('data-text', temptext);
      $('.filteredContent a', activemodule).text('Loading');
      activeFilter = param;
      if (restore == 'restart') {
        noOfitems = activemodule.attr('data-nomitems');
        offset = activemodule.attr('data-offset');
        itemstoberendered =activemodule.attr('data-torender');  
      }
      if (activeFilter) {
        var filterparam = "&technology="
        var index = activeFilter.findIndex(item => item.id == 'group');
        var gcode = activeFilter[index].value;
        if ( gcode ) {
          filterparam += gcode+",";
        }
        var index = activeFilter.findIndex(item => item.id == 'product');
        var gprod = activeFilter[index].value;
        if ( gprod ) {
          filterparam += gprod+",";
        }
        var index = activeFilter.findIndex(item => item.id == 'solutions');
        var gsol = activeFilter[index].value;
        if ( gsol ) {
          filterparam += gsol;
        }
        if (filterparam.substr(-1) == ",") {
          filterparam = filterparam.slice(0, filterparam.length - 1);
        };
        if (gcode || gsol || gprod) {
          offset = 0;
          if (typeof containerApiUrl === 'undefined') {
            containerApiUrl = activemodule.attr('data-url');
          }
          validurl =  containerApiUrl+'?offset='+offset+filterparam; 
        }

      } else {
        if (restore == 'restart') {
          noOfitems = noOfitemsload;
          offset = 0;
          itemstoberendered = itemstoberenderedload;  
          validurl =  containerApiUrl;
        } else {
          offset = $(activemodule).attr('data-offset');
          containerApiUrl = $(activemodule).attr('data-url');
          validurl =  containerApiUrl+'?offset='+offset
        }
      }
      console.log(validurl)
      $.ajax({
        url: validurl,
        type:"get",
        data:{},
        success: function(result){
          itemstoberendered = $(activemodule).attr('data-torender');
          noOfitems = $(activemodule).attr('data-nomitems');
          $(activemodule).attr('data-offset', parseInt(offset) + parseInt(itemstoberendered));
          if (param || restore) {
            $( ".listwrap", activemodule).empty();
          }
          $( ".listwrap", activemodule).append(result);

          CADENCE.updateanchors();
          feather.replace();
          $('img[data-src]', activemodule).each(function(){
            $(this).lazy({
              effect: 'fadeIn',
              defaultImage: 'data:image/gif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==',
              bind: "event"
            });
          });
          $('div[data-src], a[data-src]', activemodule).each(function(){
            $(this).lazy({
              attribute: "data-src",
              effect: 'fadeIn',
              defaultImage: 'data:image/gif;base64,R0lGODlhAQABAIAAAMLCwgAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==',
              bind: "event"
            });
          });
        }
      }).done(function() {
        if((parseInt(offset) + parseInt(itemstoberendered))>=parseInt(noOfitems) || param) {
          $('.filteredContent a', activemodule).hide();
        } else {
          $('.filteredContent a', activemodule).show();
        }



        $('.filteredContent a', activemodule).css('pointer-events', 'auto');
        var temptext = $('.filteredContent a', activemodule).attr('data-text');
        $('.filteredContent a', activemodule).text(temptext);
      });    
    };
      //DwC  filters
    if ($('.list-cont-filter').length ) {
      var dwcdefaults = {
      "hamburgerId": "dwc_menu_ham", //Hamburger Id
      "wrapperClass": "dwc_menu_outer", //Menu Wrapper Class
      "submenuClass": "submenu", //Submenu Class
      "menuStyle": "slide", //Menu Style
      "backlang": "Back", //Menu Style
      "onMenuLoad": function() { return true; }, //Calls when menu loaded
      "onMenuToggle": function() { return true; } //Calls when menu open/close
      };
      $.fn.dwcsimpleMobileMenu = function(options) {
        if (this.length === 0) { return this; }
