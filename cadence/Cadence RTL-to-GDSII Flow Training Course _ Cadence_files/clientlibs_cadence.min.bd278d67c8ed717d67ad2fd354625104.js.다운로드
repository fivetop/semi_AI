//get number of items on carousel to show  to remove unnedded space on the right,
function getCarouselItems(){
  maxWidth = getContainerWidth();
  var allItems = $('.context_menu_module .slick_context .nav-item');
  var tempWidth = 0;
  var itemstoShow = 0;
  allItems.each(function(){
    var itemWidth = $(this).outerWidth();
