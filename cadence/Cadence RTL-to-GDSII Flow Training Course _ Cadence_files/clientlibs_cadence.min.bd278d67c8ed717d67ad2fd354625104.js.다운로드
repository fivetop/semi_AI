      $('.list-container-filter .dropdownupdate.dwc').on('changed.bs.select', function (e) {
        e.preventDefault;
        e.stopImmediatePropagation();
        var link = $("option:selected", $(this))
        var dropcontainer = $(this).closest('div.dropdownupdate')
        if ( $('.cleardrop', dropcontainer).length <= 0 ) {
          $('button', dropcontainer).after("<p class='cleardrop' aria-label='Remove filter'></p>");      
        }
        writefilters(link);
      });
      $('.list-container-filter .dropdownupdate.dwc button').after("<p class='cleardrop' aria-label='Remove filter'></p>");
      noOfitemsload = $('.list-container-filter').closest('div.content').attr('data-noitems');
      offsetload = $('.list-container-filter').closest('div.content').attr('data-offset')
      itemstoberenderedload = $('.list-container-filter').closest('div.content').attr('data-torender');
      $(document.body).on('click', '.filteron svg', removefilters);
      $(document.body).on('click', '.dwcmobile_menu .submenu li:not(".back") a',  writefilters);
      $(document.body).on('click', '.list-container-filter .dropdownupdate .cleardrop', cleanfilter);
      function writefilters(element){
        var activeFilter = [
          {id: "group", value: "", name: ""},
          {id: "product", value: "", name: ""},
          {id: "solutions", value: "", name: ""},    
          ]
        var boostrapselext = false;
        if ( element.type == "click") {
          element =  event.target;
          boostrapselext = true;
        }
        var group = $(element).attr('data-group');
        var option = $(element).attr('data-value');
        if ( $(element)[0].value == undefined) {
          var value = $(element)[0].innerHTML  
        } else {
          var value = $(element)[0].value;  
        }
        elementIndex = activeFilter.findIndex((obj => obj.id == group));
        activeFilter[elementIndex].value = option;
        activeFilter[elementIndex].name = value;
        $('.dwcfilterbyinfo').children().remove().addClass('empty');
        $.each(activeFilter, function(keyName, keyValue) {
          if (keyValue.name != ""){
            $('.dwcfilterbyinfo').append("<div class='filteron' data-value="+keyValue.value+" data-group="+keyValue.id+">"+keyValue.name+"<i data-feather='x'></i></div>").removeClass('empty');
            feather.replace();
          }
          if (boostrapselext) {
            $('select.dwc option[data-value="'+option+'"]').prop("selected", true);
            $('select.dwc.bootstrap-select').selectpicker('refresh')
            manualclosedwcmenu();
          } 
        });
        list_container_showmore(activeFilter, '', $('.list-container-filter'));
        dropdownactive();
        var dropdownactivator =  element.closest('div.dropdownupdate')
        dropdownactivator.addClass('active');
        $('select', dropdownactivator).addClass('active');
        $('button', dropdownactivator).addClass('active');
        cleanfilterdropdown();
      }
      function manualclosedwcmenu() {
        $("#dwc_menu_ham").toggleClass("open");
        $(".wrapperClass").toggleClass("active").find("li.active").removeClass("active");
        $("body").toggleClass("dwcmmactive");  
        $('.dwc_menu_outer').removeClass('active');
      }
      function cleanfilter(){
        dropdownactive()
        list_container_showmore('','restart', $('.list-container-filter'));
        cleanfilterdropdown()
      }
      function dropdownactive() {
        var alldropdown = $('div.dropdownupdate')
        alldropdown.removeClass('active')
        $('select', alldropdown).removeClass('active');
        $('button', alldropdown).removeClass('active');
      }
      function cleanfilterdropdown(){
        $('.list-cont-filter select:not(".active")').val('');
        $('.list-cont-filter select:not(".active")').selectpicker('refresh');
      }
      function removefilters(element){
        var $this = element.target.closest('div.filteron');
        var group = $($this).attr('data-group');
        var option = $($this).attr('data-value');
        elementIndex = activeFilter.findIndex((obj => obj.id == group));
        activeFilter[elementIndex].value = "";
        activeFilter[elementIndex].name = "";
        droptitle = $('select.dwc option[data-value="'+option+'"]').parent().attr('title');
        var buttonselect = $('select.dwc option[data-value="'+option+'"]').parent().next()
        buttonselect.attr('title', droptitle);
        $('.filter-option .filter-option-inner-inner', buttonselect).html(droptitle);
        console.log ( JSON.stringify(activeFilter));
        $($this).remove();
        if ($('.dwcfilterbyinfo').is(':empty') ) {
          $('.dwcfilterbyinfo').addClass('empty');
        }
      }
      $(window).resize(function(){
        if ( $('body').hasClass('dwcmmactive') ) {
          manualclosedwcmenu();  
        }
      });
    }
  }
});
