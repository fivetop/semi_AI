function fillContextInfo(productPriceInfo, setContext) {
	fetch("https://ipinfo.io/json").then(
		(response) => response.json()
	).then(
		(jsonResponse) => {
			setContext(jsonResponse, productPriceInfo);
		}
	)
}


function setOncloudContext(jsonResponse, productPriceInfo) {
	$(document).ready(function() {
		Object.keys(productPriceInfo)
			.forEach(function eachKey(key) {
			if (Object.keys(productPriceInfo[key]) == jsonResponse["country"]) {
				let infoObj = Object.values(productPriceInfo[key])[0];
				$("[data-productname]").each(function() {
                    if (infoObj[$(this).data('productname')] !== 'undefined' && infoObj[$(this).data('productname')]) {
                    	$(this).closest(".price-block, .productSection").find(".amount").text(infoObj["Currency Sign"] + infoObj[$(this).data('productname')]+ "/" + infoObj["period"]);
                    }
				});
			}
		});
	});
}

$(function () {
    if (typeof productPriceInfo !== 'undefined' && productPriceInfo) {
		fillContextInfo(productPriceInfo, setOncloudContext);
	}
});

