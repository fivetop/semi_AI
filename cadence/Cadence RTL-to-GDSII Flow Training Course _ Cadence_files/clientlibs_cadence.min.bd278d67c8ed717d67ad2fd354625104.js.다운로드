$(function () {
    var UrlParameters = function UrlParameters(sParam) {
        var sPageURL = window.location.search.substring(1),
        sURLVariables = sPageURL.split('&'),
        sParameterName,
        i;
        for (i = 0; i < sURLVariables.length; i++) {
            sParameterName = sURLVariables[i].split('=');
            if (sParameterName[0] === sParam) {
                return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
            }
        }
    };
    var loadmodal =  UrlParameters('open');
    if (loadmodal != undefined) {
        function ShowautoModal(data)  {
            $('.modal-autoModal').append(data);
            $('.modal-autoModal .modal').modal('show');
        }
        $('body').append('<div class="modal-autoModal"></div>');
        $('body').on('show.bs.modal','.modal-autoModal .modal', function () {//enable autoplay on opening the modal
            if ( $('.limelight-player', $(this)).length >= 1) {
                var $video = $('.LimelightEmbeddedPlayer object,.LimelightEmbeddedPlayer video,#LimelightEmbeddedPlayer video', this.$modal);
                if ($video.length) {
                    var that = this;
                    var player = $video.closest('div.limelight-player').attr('id');
                    playerid = document.getElementById(player);
                    playerid.doPlay();
                }
            }
            if ( $('.vidyard-player-embed', $(this)).length >= 1) {
