$(function(){
    if ( $('nav#profile-nav').length >= 1) {
        function checkdrop() {
            if ($("#profile-nav .dropdownupdate").hasClass('open')){
                $("#profile-nav .dropdownupdate").selectpicker('toggle');      
            }
        }

        function slick_slider() {
            var wrapper = $('#profile-nav .menu');
            if ($(".slick-initialized").length) {
                wrapper.slick('unslick');
            } else {
             wrapper .on('swipe', function(event, slick, currentSlide, nextSlide){
                  checkdrop();      
             });
            }
            wrapper.slick({
                speed: 300,
                infinite: false,
                accessibility: false,
                respondTo: 'slider',
                edgeFriction: 1,
                arrows: false,
                draggable: true,
                pauseOnHover: true,
                mobileFirst: true,
                slidesToShow: 1,
                variableWidth: true,
                responsive: [{
                    breakpoint: 768,
                    settings: "unslick"
                }]
            });
        }
        slick_slider();

        $(window).resize(function(){
            slick_slider();
            checkdrop();
        });
        
        var navigationbox =  $('nav#profile-nav');
        $('.menu li', navigationbox).on('click', function(){
            if ( $(this).hasClass('active') ) {
                $(this).removeClass('active');
            }
            else {
                $('li', navigationbox).removeClass('active');
                $(this).addClass('active');   
            }
        });

        $(document).click(function(event) { 
          var $target = $(event.target);
          if(!$target.closest('nav#profile-nav').length)  {
            $('li', navigationbox).removeClass('active');
          }        
        });
    }
});
