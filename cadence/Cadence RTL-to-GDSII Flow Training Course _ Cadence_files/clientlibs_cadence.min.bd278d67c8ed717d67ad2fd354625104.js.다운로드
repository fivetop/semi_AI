	function getItOn(e){
		$this = e.target;
		getcurlce = '.circuleinfo.'+$this.alt;
		if ( $(getcurlce).hasClass('show') == false ) {
			var getCenter = getAreaCenter($this.shape, $this.coords);
	    	$('.circuleinfo').removeClass('show');
	    	if ($(window).width() > 1199) {
	    		$(getcurlce).css('top', (parseInt(getCenter[1])+60));
				$(getcurlce).css('left', (parseInt(getCenter[0])-80));
	    	}
	    	if ($(window).width() <= 1199 ) {
	    		$(getcurlce).css('top', (parseInt(getCenter[1])+0));
				$(getcurlce).css('left', (parseInt(getCenter[0])-100));
	    	}
	    	if ($(window).width() <= 1024 ) {
	    		$(getcurlce).css('top', (parseInt(getCenter[1])-25));
				$(getcurlce).css('left', (parseInt(getCenter[0])-100));
	    	}
			$(getcurlce).addClass('show');	
		}
	}

	function getAreaCenter(shape, coords) {
		var coordsArray = coords.split(','),
			center = [];
		if (shape == 'circle') {
			center = [coordsArray[0], coordsArray[1]];
		} else {
			var coord,
				minX = maxX = parseInt(coordsArray[0], 10),
				minY = maxY = parseInt(coordsArray[1], 10);
			for (var i = 0, l = coordsArray.length; i < l; i++) {
				coord = parseInt(coordsArray[i], 10);
				if (i%2 == 0) { // Even values are X coordinates
					if (coord < minX) {
						minX = coord;
					} else if (coord > maxX) {
						maxX = coord;
					}
				} else { // Odd values are Y coordinates
					if (coord < minY) {
						minY = coord;
					} else if (coord > maxY) {
						maxY = coord;
					}
				}
			}
			center = [parseInt((minX + maxX) / 2, 10), parseInt((minY + maxY) / 2, 10)];
		}
		return(center);
	}

//end ready
