function sortCadenceAlliances(sort_field, device) {
    var columns = (device == undefined) ? 3 : (device == "tablet") ? 2 : 1;
	var rows = $('#alliances_items .alliances_item').get();
	rows.sort(function(a, b) {
		var A = $(a).find('.' + sort_field).text();
		var B = $(b).find('.' + sort_field).text();
		if(A < B) {
			return -1;
		}
		if(A > B) {
			return 1;
		}
		return 0;
	});
	var totalrows = rows.length;
	var col = Math.ceil(totalrows/columns);
	var currentObj = null;

	var vrow = $(document.createElement('div'));
	vrow.addClass('row');

	$.each(rows, function(index, row) {
		if(index % col == 0)
		{
			var vitem = $(document.createElement('div'));
			vitem.addClass('col-md-4');
			currentObj = vitem;
			$(currentObj).append(row);
			$(vrow).append(currentObj);
		}
		else {
			$(currentObj).append(row);
			$(vrow).append(currentObj);
		}
	});
	$('#alliances_items').append(vrow);
}

